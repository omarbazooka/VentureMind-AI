APP_ENV=development

DATABASE_URL=postgresql+psycopg://username:password@host:5432/database
CORS_ORIGINS=http://localhost:3000

GEMINI_API_KEY=
GROQ_API_KEY=
FIRECRAWL_API_KEY=

SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
ENABLE_DEV_AUTH_BYPASS=false

TURN_UNDERSTANDING_MODEL=gemini-3.1-flash-lite
MARKET_RESEARCH_MODEL=gemini-3.5-flash-lite
COMPETITOR_INTELLIGENCE_MODEL=gemini-3.5-flash-lite
CUSTOMER_INTELLIGENCE_MODEL=gemini-3.5-flash-lite
BUSINESS_STRATEGY_MODEL=gemini-3.5-flash-lite
FINANCE_ASSUMPTION_MODEL=gemini-3.5-flash-lite
RISK_ANALYSIS_MODEL=gemini-3.5-flash-lite

# Fallback cascade when requests/rate-limits/quota run out for primary models
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
